{
  "name": "@stradox/paystack",
  "version": "1.0.0-rc.2",
  "description": "A strongly typed Paystack API wrapper for Node.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stradox4u/stradox-paystack.git"
  },
  "bugs": {
    "url": "https://github.com/stradox4u/stradox-paystack/issues"
  },
  "homepage": "https://github.com/stradox4u/stradox-paystack#readme",
  "keywords": [
    "paystack",
    "payments",
    "typescript",
    "nodejs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
